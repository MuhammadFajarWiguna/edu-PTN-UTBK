# ═══════════════════════════════════════════════════════════════
# EDUPTN ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────
# 🔑 GEMINI AI API
# ────────────────────────────────────────────────────────────────
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ────────────────────────────────────────────────────────────────
# 🗄️ SUPABASE DATABASE
# ────────────────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL="https://ysveoqfelzwdldhzkkws.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# For frontend (Vite requires VITE_ prefix)
VITE_SUPABASE_URL="https://ysveoqfelzwdldhzkkws.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# ────────────────────────────────────────────────────────────────
# 🚂 RAILWAY BACKEND API
# ────────────────────────────────────────────────────────────────
RAILWAY_API_URL="https://utbk-backend-production.up.railway.app/api/v1"
VITE_RAILWAY_API_URL="https://utbk-backend-production.up.railway.app/api/v1"

# ────────────────────────────────────────────────────────────────
# 🔐 GOOGLE OAUTH (FOR SERVER.JS - NOT NEEDED FOR VERCEL)
# ────────────────────────────────────────────────────────────────
# Get credentials from: https://console.cloud.google.com/apis/credentials
# NOTE: Not needed if using Supabase Auth (recommended for Vercel)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:5001/auth/google/callback"

# ────────────────────────────────────────────────────────────────
# 🔐 LINKEDIN OAUTH (FOR SERVER.JS - NOT NEEDED FOR VERCEL)
# ────────────────────────────────────────────────────────────────
# Get credentials from: https://www.linkedin.com/developers/apps
# NOTE: Not needed if using Supabase Auth
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"
LINKEDIN_CALLBACK_URL="http://localhost:5001/auth/linkedin/callback"

# ────────────────────────────────────────────────────────────────
# 🔒 SESSION SECRET (FOR SERVER.JS - NOT NEEDED FOR VERCEL)
# ────────────────────────────────────────────────────────────────
# Generate strong random string for production
# NOTE: Not needed if using Supabase Auth
SESSION_SECRET="your-super-secret-session-key-change-this"

# ────────────────────────────────────────────────────────────────
# 🌐 APP URL
# ────────────────────────────────────────────────────────────────
APP_URL="http://localhost:5001"

# ────────────────────────────────────────────────────────────────
# 📦 SINGLEBASE (OPTIONAL - ALTERNATIVE TO SUPABASE)
# ────────────────────────────────────────────────────────────────
SINGLEBASE_PUBLISHABLE_KEY=""
SINGLEBASE_SECRET_KEY=""

# ═══════════════════════════════════════════════════════════════
# 📋 NOTES
# ═══════════════════════════════════════════════════════════════

# FOR LOCAL DEVELOPMENT:
# 1. Copy this file to .env
# 2. Fill in your actual API keys
# 3. Never commit .env to git

# FOR VERCEL DEPLOYMENT:
# Set these variables in Vercel Dashboard → Settings → Environment Variables:
# - VITE_SUPABASE_URL
# - VITE_SUPABASE_ANON_KEY
# - VITE_RAILWAY_API_URL
# - GEMINI_API_KEY

# OAUTH CONFIGURATION:
# - For local dev: Use server.js with Google/LinkedIn OAuth
# - For Vercel: Use Supabase Auth (no server.js needed)
# - Configure OAuth in Supabase Dashboard → Authentication → Providers

# CALLBACK URLS:
# Supabase OAuth Callback (use this in Google Console):
#   https://ysveoqfelzwdldhzkkws.supabase.co/auth/v1/callback
#
# Add these redirect URIs in Google Cloud Console:
#   - https://ysveoqfelzwdldhzkkws.supabase.co/auth/v1/callback
#   - https://your-app.vercel.app
#   - https://your-app-*.vercel.app
#   - http://localhost:5001

# ═══════════════════════════════════════════════════════════════