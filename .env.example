# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The API URL of your Supabase instance, e.g. https://xxxxxx.supabase.co
SUPABASE_URL=""

# SUPABASE_ANON_KEY: The public anonymous key of your Supabase database instance.
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# RAILWAY_API_URL: URL backend Railway yang sudah di-deploy
# Development: http://localhost:3000/api/v1
# Production:  https://utbk-backend-production.up.railway.app/api/v1
RAILWAY_API_URL="https://utbk-backend-production.up.railway.app/api/v1"

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:5001/auth/google/callback"

# Session Secret (generate strong random string for production)
SESSION_SECRET="your-super-secret-session-key"

# LinkedIn OAuth Configuration
# Get credentials from: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"
LINKEDIN_CALLBACK_URL="http://localhost:5001/auth/linkedin/callback"

SINGLEBASE_PUBLISHABLE_KEY=""
SINGLEBASE_SECRET_KEY=""